---
import '../styles/global.css';
import MainNavbar from '../components/MainNavbar';
import WhatsAppFloatingButton from '../components/WhatsAppFloatingButton';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
	forceScrolled?: boolean;
}

const { title, description = "Inkaland Explorers - Tu puerta de entrada al mundo Inca", forceScrolled = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#0b403a] text-white font-['Inter'] selection:bg-[#dfa126] selection:text-black">
		<MainNavbar client:load lang={lang} forceScrolled={forceScrolled} />
		<slot />
		<WhatsAppFloatingButton client:load />
	</body>

</html>

<style is:global>
	:root {
		--primary: #dfa126;
		--secondary: #0b403a;
	}
	
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Outfit', sans-serif;
	}

	.glass-panel {
		background: rgba(255, 255, 255, 0.03);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.05);
	}
</style>
