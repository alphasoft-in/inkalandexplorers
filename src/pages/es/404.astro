---
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter";
---

<Layout title="404 Página no encontrada | Inkaland Explorers" forceScrolled={true}>
	<main class="w-full bg-[#F9F6EE] min-h-screen flex flex-col">
		<section class="relative flex-grow flex items-center justify-center overflow-hidden pt-40 pb-20">
			<div class="absolute inset-0 z-0">
				<img src="/hero-machu-picchu.avif" alt="Machu Picchu Background" class="w-full h-full object-cover" fetchpriority="high" decoding="async" />
				<div class="absolute inset-0 bg-gradient-to-b from-[#0b403a]/90 via-[#0b403a]/70 to-[#0b403a]/90"></div>
			</div>
			
			<div class="relative z-10 max-w-xl mx-auto px-4 sm:px-6 w-full text-center flex flex-col items-center justify-center">
				<div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 md:p-8 rounded-3xl shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] transform transition-transform duration-500 hover:scale-[1.02] text-center w-full">
					<h1 class="font-['Outfit'] text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-br from-[#dfa126] to-[#f3d088] mb-2 drop-shadow-lg text-center">
						404
					</h1>
					<h2 class="font-['Outfit'] text-lg md:text-xl font-bold text-white mb-4 text-center">
						Página no encontrada
					</h2>
					<p class="text-white/80 text-sm md:text-base mb-8 max-w-md mx-auto leading-relaxed text-center">
						Parece que te has desviado del camino. La página que buscas no existe o ha sido movida.
					</p>
					<div class="flex flex-col sm:flex-row items-center justify-center gap-5">
						<a href="/es/" class="px-8 py-4 bg-[#dfa126] hover:bg-[#c98e1e] text-white font-bold rounded-xl transition-all duration-300 transform hover:-translate-y-1 shadow-lg shadow-[#dfa126]/30 flex items-center gap-2">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
							Ir al Inicio
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter lang="es" />
</Layout>