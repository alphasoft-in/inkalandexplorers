---
import Layout from "../../layouts/Layout.astro";
import MainHero from "../../components/MainHero";
import FeaturedPackages from "../../components/FeaturedPackages";
import AvailabilityWidget from "../../components/AvailabilityWidget";
import TripInquiryForm from "../../components/TripInquiryForm";
import SiteFooter from "../../components/SiteFooter";
---

<Layout title="Inkaland Explorers | Trekking en Perú, Treks en Cusco y Viajes de Lujo" description="Explora la capital del Imperio Inca en 2026: Machu Picchu, Valle Sagrado, Montaña de 7 Colores, Laguna Humantay. Patrimonio UNESCO. Aventura andina. Reserva con Inkaland Explorers.">
	<main class="w-full bg-[#0b403a]">
		<!-- Main Hero -->
		<MainHero client:load lang="es" />

		<!-- Featured Packages -->
		<FeaturedPackages client:visible lang="es" />

		<!-- Availability Widget -->
		<AvailabilityWidget client:visible lang="es" />

		<!-- Call to Action -->
		<TripInquiryForm client:load lang="es" />

		<!-- Footer -->
		<SiteFooter lang="es" />
	</main>
</Layout>

<style>
	@keyframes gradient {
		0% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
		100% {
			background-position: 0% 50%;
		}
	}
	.animate-gradient {
		background-size: 200% auto;
		animation: gradient 4s linear infinite;
	}
</style>