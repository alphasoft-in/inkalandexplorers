---
// Force rebuild with latest package data
import Layout from "../../../layouts/Layout.astro";
import SiteFooter from "../../../components/SiteFooter";
import TripInquiryForm from "../../../components/TripInquiryForm";
import { packages } from "../../../data/packages";
import RecommendedPackages from "../../../components/RecommendedPackages";

export async function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
const lang = 'es';
const t = pkg[lang];
---

<Layout title={`${t.title} | Inkaland Explorers`} forceScrolled={true}>
	<main class="bg-white">


		<!-- Hero Section -->
		<section class="relative h-[75vh] min-h-[600px] flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0 z-0">
				<img src={pkg.image} alt={t.title} class="w-full h-full object-cover" />
				<!-- Multi-layer overlay for depth and legibility -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/20 to-black/80"></div>
				<div class="absolute inset-0 bg-[#0b403a]/40"></div>
			</div>
			<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">


				<div class="max-w-4xl mx-auto">
					<nav class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold">
						<a href="/es" class="hover:text-white transition-colors">Inicio</a>
						<span class="mx-3 text-white/30">/</span>
						<span class="text-white/60">Tours</span>
					</nav>
					<h1 class="font-['Outfit'] text-4xl md:text-6xl font-bold text-white mb-6 leading-tight drop-shadow-2xl">
						{t.title}
					</h1>
					<p class="text-lg md:text-xl text-white/90 font-light max-w-2xl mx-auto leading-relaxed">
						{t.description}
					</p>


				</div>
			</div>
		</section>

		<!-- Tour Details Grid -->
		<div class="relative z-20 -mt-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<!-- 1. Tipo de Tour -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Tipo de Tour</p>
						<p class="text-[#0b403a] font-semibold">{pkg.type}</p>
					</div>
				</div>

				<!-- 2. Duración -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Duración</p>
						<p class="text-[#0b403a] font-semibold">{pkg.duration}</p>
					</div>
				</div>

				<!-- 3. Elevación -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Elevación</p>
						<p class="text-[#0b403a] font-semibold">{pkg.altitude}</p>
					</div>
				</div>

				<!-- 4. Dificultad -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Dificultad</p>
						<p class="text-[#0b403a] font-semibold">{pkg.difficulty}</p>
					</div>
				</div>

				<!-- 5. Salida -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Salida</p>
						<p class="text-[#0b403a] font-semibold">{pkg.departure}</p>
					</div>
				</div>

				<!-- 6. Destino -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-7l.5 1H21l-3-6 3-6h-8.5l-1-1H5" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Destino</p>
						<p class="text-[#0b403a] font-semibold">{(pkg.destination || '').replace(/<[^>]*>?/gm, '')}</p>
					</div>
				</div>

				<!-- 7. Latitud -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Latitud</p>
						<p class="text-[#0b403a] font-semibold">{pkg.latitude !== undefined ? pkg.latitude : 'N/A'}</p>
					</div>
				</div>

				<!-- 8. Longitud -->
				<div class="bg-[#F9F6EE] border border-black/5 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<div>
						<p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Longitud</p>
						<p class="text-[#0b403a] font-semibold">{pkg.longitude !== undefined ? pkg.longitude : 'N/A'}</p>
					</div>
				</div>
			</div>
		</div>



		<!-- Content Section -->
		<section class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid lg:grid-cols-[1fr_380px] gap-12">

					
					<!-- Left Side: Main Content -->
					<div class="lg:col-span-1 space-y-8">


						<!-- Overview -->
						<div class="prose prose-lg max-w-none">
							<h2 class="font-['Outfit'] text-3xl font-bold text-[#0b403a] mb-6">Resumen del Viaje</h2>
							<p class="text-gray-600 leading-relaxed font-light">
								{t.overview}
							</p>
						</div>

						<!-- Itinerary -->
						<div>
							<h2 class="font-['Outfit'] text-3xl font-bold text-[#0b403a] mb-8">Itinerario Detallado</h2>
							<div class="space-y-0 relative before:absolute before:left-[11px] before:top-4 before:bottom-4 before:w-0.5 before:bg-[#0b403a]/10">
								{t.itinerary.map((item: { time: string; activity: string }) => (
									<div class="relative pl-10 pb-6 last:pb-0">

										<div class="absolute left-0 top-1 w-6 h-6 rounded-full bg-white border-4 border-[#0b403a] z-10"></div>
										<p class="text-[10px] uppercase tracking-widest font-bold text-[#dfa126] mb-1">{item.time}</p>
										<p class="text-gray-700 font-light text-lg leading-snug">{item.activity}</p>
									</div>
								))}
							</div>
						</div>

						<!-- Includes / Excludes -->
						<div class="grid md:grid-cols-2 gap-4 pt-0">
							<div class="bg-gray-50 p-6 rounded-2xl border border-black/5">
								<h3 class="font-bold text-[#0b403a] mb-4 flex items-center gap-2">

									<svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
									</svg>
									Incluye
								</h3>
								<ul class="space-y-2">

									{t.includes.map((item: string) => (
										<li class="flex items-start gap-3 text-gray-600 text-sm font-light">
											<span class="w-1.5 h-1.5 rounded-full bg-[#dfa126] mt-1.5 shrink-0"></span>
											{item}
										</li>
									))}
								</ul>
							</div>
							<div class="bg-gray-50 p-6 rounded-2xl border border-black/5">
								<h3 class="font-bold text-[#0b403a] mb-4 flex items-center gap-2">

									<svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
									</svg>
									No Incluye
								</h3>
								<ul class="space-y-2">

									{t.excludes.map((item: string) => (
										<li class="flex items-start gap-3 text-gray-400 text-sm font-light italic">
											<span class="w-1.5 h-1.5 rounded-full bg-gray-300 mt-1.5 shrink-0"></span>
											{item}
										</li>
									))}
								</ul>
							</div>
						</div>

						<!-- Packing List -->
						<div class="bg-[#F9F6EE] p-6 md:p-8 rounded-3xl border border-[#dfa126]/10">
							<h3 class="font-['Outfit'] text-2xl font-bold text-[#0b403a] mb-6 flex items-center gap-3">
								<div class="w-10 h-10 rounded-xl bg-[#dfa126] flex items-center justify-center text-white">
									<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
									</svg>
								</div>
								{lang === 'es' ? 'Qué llevar' : 'What to bring'}
							</h3>
							<ul class="grid sm:grid-cols-2 gap-x-12 gap-y-2">
								{t.packing.map((item: string) => (
									<li class="flex items-center gap-3 text-gray-600 text-sm font-light">
										<svg class="w-5 h-5 text-[#dfa126]" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
										{item}
									</li>
								))}
							</ul>
						</div>

						{t.highlights && t.highlights.length > 0 && (
							<div class="space-y-6">
								<h3 class="font-['Outfit'] text-2xl font-bold text-[#0b403a]">{lang === 'es' ? 'Lo más destacado' : 'Tour Highlights'}</h3>
								<div class="grid gap-4">
									{t.highlights.map((highlight: string) => (
										<div class="flex items-start gap-4 p-4 rounded-xl bg-[#0b403a]/5 border border-[#0b403a]/10">
											<div class="w-8 h-8 rounded-full bg-[#0b403a] flex items-center justify-center text-white shrink-0">
												<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
												</svg>
											</div>
											<p class="text-gray-700 font-light leading-relaxed">{highlight}</p>
										</div>
									))}
								</div>
							</div>
						)}

						{t.tips && t.tips.length > 0 && (
							<div class="bg-[#0b403a] text-white p-8 rounded-3xl space-y-6">
								<div class="flex items-center gap-3">
									<div class="w-10 h-10 rounded-xl bg-[#dfa126] flex items-center justify-center">
										<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
										</svg>
									</div>
									<h3 class="font-['Outfit'] text-2xl font-bold">{lang === 'es' ? 'Consejos de Expertos' : 'Pro Travel Tips'}</h3>
								</div>
								<ul class="grid md:grid-cols-2 gap-4">
									{t.tips.map((tip: string) => (
										<li class="flex items-start gap-3 text-white/80 text-sm font-light">
											<span class="w-1.5 h-1.5 rounded-full bg-[#dfa126] mt-1.5 shrink-0"></span>
											{tip}
										</li>
									))}
								</ul>
							</div>
						)}

					</div>



					<!-- Right Side: Sidebar -->
					<div class="relative">
						<!-- Booking Card -->
						<div class="sticky top-28 bg-[#0b403a] text-white p-8 rounded-3xl shadow-2xl overflow-hidden">
							<div class="absolute -right-8 -top-8 w-32 h-32 bg-[#dfa126] rounded-full blur-3xl opacity-20"></div>
							<p class="text-xs uppercase tracking-[0.2em] text-[#dfa126] font-bold mb-2">Precio Privado</p>
							<div class="flex items-baseline gap-2 mb-8">
								<span class="text-5xl font-bold font-['Outfit']">${pkg.price}</span>
								<span class="text-white/60 text-sm italic">por persona</span>
							</div>
							<div class="space-y-4 mb-8">
								<div class="flex items-center gap-3 text-sm font-light py-3 border-b border-white/10">
									<svg class="w-5 h-5 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
									Guía Privado Certificado
								</div>
								<div class="flex items-center gap-3 text-sm font-light py-3 border-b border-white/10">
									<svg class="w-5 h-5 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
									Recojo Directo del Hotel
								</div>
								<div class="flex items-center gap-3 text-sm font-light py-3 border-b border-white/10">
									<svg class="w-5 h-5 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
									Itinerario Flexible
								</div>
							</div>
							<div class="space-y-4">
								<a href="#inquiry" class="block w-full bg-[#dfa126] text-[#0b403a] text-center font-bold py-5 rounded-2xl hover:bg-white transition-all duration-300 transform hover:scale-[1.02] active:scale-95 uppercase tracking-widest text-xs shadow-xl shadow-black/20">
									Reservar Este Viaje
								</a>
								<a 
									href={`https://wa.me/51951231364?text=${encodeURIComponent(`Hola Inkaland Explorers, me gustaría consultar sobre el tour: ${t.title}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="block w-full bg-[#25D366] text-white text-center font-bold py-5 rounded-2xl hover:bg-[#128C7E] transition-all duration-300 transform hover:scale-[1.02] active:scale-95 uppercase tracking-widest text-xs shadow-xl shadow-[#25D366]/20 flex items-center justify-center gap-3"
								>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
									</svg>
									Consultar por WhatsApp
								</a>
							</div>
						</div>
					</div>


				</div>
			</div>
		</section>

		<div id="inquiry">
			<TripInquiryForm client:load lang="es" />
		</div>

		<RecommendedPackages client:visible lang="es" excludeId={pkg.id} />

		<SiteFooter />
	</main>
</Layout>

<style>
	/* Smooth scrolling for anchor links */
	html {
		scroll-behavior: smooth;
	}
</style>
