---
// Force rebuild with latest package data
import Layout from "../../../layouts/Layout.astro";
import SiteFooter from "../../../components/SiteFooter";
import TripInquiryForm from "../../../components/TripInquiryForm";
import { packages } from "../../../data/packages";
import RecommendedPackages from "../../../components/RecommendedPackages";

export async function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}

const { pkg } = Astro.props;
const lang = 'es' as string;
const t = pkg[lang as 'en' | 'es'];
const isPrivate = pkg.en.title.toLowerCase().includes('private');
const activeTabOverride = isPrivate ? 'packages' : 'destinations';
---

<Layout title={`${t.title} | Inkaland Explorers`} forceScrolled={true} activeTabOverride={activeTabOverride}>
	<main class="bg-white">


		<!-- Hero Section -->
		<section class="relative h-[65vh] min-h-[550px] flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0 z-0">
				<img src={pkg.image} alt={t.title} class="w-full h-full object-cover" />
				<!-- Multi-layer overlay for depth and legibility -->
				<div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/20 to-black/80"></div>
				<div class="absolute inset-0 bg-[#0b403a]/40"></div>
			</div>
			<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">


				<div class="max-w-4xl mx-auto">
					<nav class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold">
						<a href="/es" class="hover:text-white transition-colors">Inicio</a>
						<span class="mx-3 text-white/30">/</span>
						{isPrivate ? (
							<span class="text-white/60">Tours</span>
						) : (
							<a href={`/es/destinos/${pkg.destination.toLowerCase().split('|')[0].trim().replace(/ /g, '-')}`} class="text-white/60 hover:text-white transition-colors">Destinos</a>
						)}
					</nav>
					<h1 class="font-['Outfit'] text-3xl md:text-5xl font-bold text-white mb-5 leading-tight drop-shadow-2xl">
						{t.title}
					</h1>
					<p class="text-base md:text-lg text-white/90 font-light max-w-2xl mx-auto leading-relaxed">
						{t.description}
					</p>


				</div>
			</div>
		</section>

		<!-- Tour Details Grid -->
		<div class="relative z-20 -mt-[104px] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
				<!-- 1. Tipo de Tour -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 16v-2.38C4 11.5 2.97 10.5 3 8c.03-2.72 1.49-6 4.5-6C9.37 2 10 3.8 10 5.5c0 3.11-2 5.66-2 8.68V16a2 2 0 1 1-4 0Z"/>
							<path d="M20 20v-2.38c0-2.12 1.03-3.12 1-5.62-.03-2.72-1.49-6-4.5-6C14.63 6 14 7.8 14 9.5c0 3.11 2 5.66 2 8.68V20a2 2 0 1 0 4 0Z"/>
							<path d="M16 17h4"/>
							<path d="M4 13h4"/>
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Tipo de Tour</p>
						<p class="text-[#0b403a] text-sm">{pkg.type || 'N/A'}</p>
					</div>
				</div>

				<!-- 2. Duración -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Duración</p>
						<p class="text-[#0b403a] text-sm">{pkg.duration}</p>
					</div>
				</div>

				<!-- 3. Elevación -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M8 7L2 20h20L15 11l-3 4-4-8z" />
							<circle cx="8" cy="3" r="1.5" />
							<path d="M5.5 12l2 1.5 3-2" />
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Elevación</p>
						<p class="text-[#0b403a] text-sm">{pkg.altitude || 'N/A'}</p>
					</div>
				</div>

				<!-- 4. Dificultad -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 16h4v4H4zm6-6h4v10h-4zm6-6h4v16h-4z" />
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Dificultad</p>
						<p class="text-[#0b403a] text-sm">{pkg.difficulty || 'N/A'}</p>
					</div>
				</div>

				<!-- 5. Salida -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Salida</p>
						<p class="text-[#0b403a] text-sm">{pkg.departure || 'N/A'}</p>
					</div>
				</div>

				<!-- 6. Destino -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 8c0 3.613-3.869 7.429-5.393 8.795a1 1 0 0 1-1.214 0C9.87 15.429 6 11.613 6 8a6 6 0 0 1 12 0"/><circle cx="12" cy="8" r="2"/><path d="M8.714 14h-3.71a1 1 0 0 0-.948.683l-2.004 6A1 1 0 0 0 3 22h18a1 1 0 0 0 .948-1.316l-2-6a1 1 0 0 0-.949-.684h-4.286"/>
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Destino</p>
						<p class="text-[#0b403a] text-sm">{(pkg.destination || '').replace(/<[^>]*>?/gm, '')}</p>
					</div>
				</div>

				<!-- 7. Latitud -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Latitud</p>
						<p class="text-[#0b403a] text-sm">{pkg.latitude !== undefined ? pkg.latitude : 'N/A'}</p>
					</div>
				</div>

				<!-- 8. Longitud -->
				<div class="bg-[#F9F6EE]/95 backdrop-blur-md border border-[#0b403a]/20 p-6 rounded-2xl shadow-xl hover:shadow-2xl transition-all flex items-center gap-5">

					<div class="w-12 h-12 rounded-xl bg-[#0b403a]/5 flex items-center justify-center text-[#0b403a] shrink-0">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<line x1="2" x2="5" y1="12" y2="12"/><line x1="19" x2="22" y1="12" y2="12"/><line x1="12" x2="12" y1="2" y2="5"/><line x1="12" x2="12" y1="19" y2="22"/><circle cx="12" cy="12" r="7"/>
						</svg>
					</div>
					<div>
						<p class="text-sm font-medium text-gray-500 mb-1">Longitud</p>
						<p class="text-[#0b403a] text-sm">{pkg.longitude !== undefined ? pkg.longitude : 'N/A'}</p>
					</div>
				</div>
			</div>
		</div>



		<!-- Content Section -->
		<section class="py-20">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid lg:grid-cols-[1fr_380px] gap-12">

					
					<!-- Left Side: Main Content -->
					<div class="lg:col-span-1 space-y-8">


						<!-- Overview -->
						<div class="prose prose-lg max-w-none">
							<h2 class="font-['Outfit'] text-3xl font-bold text-[#0b403a] mb-6">Descripción del Tour</h2>
							<div class="text-gray-600 leading-relaxed font-light whitespace-pre-line" set:html={t.overview} />
						</div>

						<!-- Itinerary -->
						<div>
							<h2 class="font-['Outfit'] text-3xl font-bold text-[#0b403a] mb-6">Itinerario Detallado</h2>
							<div class="space-y-0 relative before:absolute before:left-[11px] before:top-4 before:bottom-4 before:w-0.5 before:bg-[#0b403a]/10">
								{t.itinerary.map((item: any) => {
									if ('day' in item) {
										return (
											<div class="relative pl-10 pb-8 last:pb-0">
												<div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-4 border-[#0b403a] z-10"></div>
												<p class="text-sm uppercase tracking-widest font-bold text-[#dfa126] mb-2">Día {item.day}: {item.title}</p>
												<div class="space-y-4">
													{item.activities.map((act: any) => (
														<div class="pl-4 border-l-2 border-[#dfa126]/30">
															<p class="text-[10px] uppercase tracking-widest font-bold text-[#dfa126] mb-0.5">{act.time}</p>
															<p class="text-gray-700 font-light text-sm leading-relaxed whitespace-pre-line">{act.description}</p>
														</div>
													))}
												</div>
											</div>
										);
									}
									return (
										<div class="relative pl-10 pb-5 last:pb-0">
											<div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-4 border-[#0b403a] z-10"></div>
											<p class="text-[10px] uppercase tracking-widest font-bold text-[#dfa126] mb-0.5">{item.time}</p>
											<p class="text-gray-700 font-light text-sm leading-relaxed whitespace-pre-line">{item.activity}</p>
										</div>
									);
								})}
							</div>
						</div>

						<!-- Includes / Excludes -->
						<div class="grid md:grid-cols-2 gap-4 pt-0">
							<div class="bg-gray-50 p-6 rounded-2xl border border-black/5">
								<h3 class="font-bold text-[#0b403a] mb-4 flex items-center gap-2">

									<svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
									</svg>
									Incluye
								</h3>
								<ul class="space-y-2">

									{t.includes.map((item: string) => (
										<li class="flex items-start gap-3 text-gray-600 text-sm font-light">
											<span class="w-1.5 h-1.5 rounded-full bg-[#dfa126] mt-1.5 shrink-0"></span>
											{item}
										</li>
									))}
								</ul>
							</div>
							<div class="bg-gray-50 p-6 rounded-2xl border border-black/5">
								<h3 class="font-bold text-[#0b403a] mb-4 flex items-center gap-2">

									<svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
									</svg>
									No Incluye
								</h3>
								<ul class="space-y-2">

									{t.excludes.map((item: string) => (
										<li class="flex items-start gap-3 text-gray-400 text-sm font-light italic">
											<span class="w-1.5 h-1.5 rounded-full bg-gray-300 mt-1.5 shrink-0"></span>
											{item}
										</li>
									))}
								</ul>
							</div>
						</div>

						<!-- Packing List -->
						<div class="bg-[#F9F6EE] p-6 rounded-2xl border border-[#dfa126]/10">
							<h3 class="font-['Outfit'] text-xl font-bold text-[#0b403a] mb-5 flex items-center gap-3">
								<div class="w-8 h-8 rounded-lg bg-[#dfa126] flex items-center justify-center text-white">
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
									</svg>
								</div>
								{lang === 'es' ? 'Qué llevar' : 'What to bring'}
							</h3>
							<ul class="grid sm:grid-cols-2 gap-x-12 gap-y-2">
								{t.packing.map((item: string) => (
									<li class="flex items-center gap-2 text-gray-600 text-sm font-light">
										<svg class="w-4 h-4 text-[#dfa126]" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
										</svg>
										{item}
									</li>
								))}
							</ul>
						</div>



						{t.tips && t.tips.length > 0 && (
							<div class="bg-[#0b403a] text-white p-6 rounded-2xl space-y-5">
								<div class="flex items-center gap-3">
									<div class="w-8 h-8 rounded-lg bg-[#dfa126] flex items-center justify-center">
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
										</svg>
									</div>
									<h3 class="font-['Outfit'] text-xl font-bold">{lang === 'es' ? 'Consejos de Expertos' : 'Pro Travel Tips'}</h3>
								</div>
								<ul class="grid md:grid-cols-2 gap-3">
									{t.tips.map((tip: string) => (
										<li class="flex items-start gap-2.5 text-white/80 text-sm font-light">
											<span class="w-1.5 h-1.5 rounded-full bg-[#dfa126] mt-1.5 shrink-0"></span>
											<span class="leading-relaxed">{tip}</span>
										</li>
									))}
								</ul>
							</div>
						)}

					</div>



					<!-- Right Side: Sidebar -->
					<div class="relative">
						<!-- Booking Card -->
						<div class="sticky top-28 bg-[#0b403a] text-white p-8 rounded-3xl shadow-2xl overflow-hidden">
							<div class="absolute -right-8 -top-8 w-32 h-32 bg-[#dfa126] rounded-full blur-3xl opacity-20"></div>
							<p class="text-xs uppercase tracking-[0.2em] text-[#dfa126] font-bold mb-2">Precio Privado</p>
							<div class="flex items-baseline gap-2 mb-8">
								<span class="text-5xl font-bold font-['Outfit']">${pkg.price}</span>
								<span class="text-white/60 text-sm italic">por persona</span>
							</div>
							<div class="space-y-2 mb-8">
								{t.highlights && t.highlights.length > 0 ? (
									<>
										<p class="text-[#dfa126] font-bold text-xs mb-3 uppercase tracking-widest">{lang === 'es' ? 'Lo más destacado' : 'Tour Highlights'}</p>
										{t.highlights.map((highlight: string) => (
											<div class="flex items-start gap-2.5 text-xs font-light py-1.5 border-b border-white/10 last:border-0">
												<svg class="w-4 h-4 text-[#dfa126] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
												<span class="leading-snug text-white/90">{highlight}</span>
											</div>
										))}
									</>
								) : (
									<>
										<div class="flex items-center gap-2.5 text-xs font-light py-2 border-b border-white/10">
											<svg class="w-4 h-4 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
											{lang === 'es' ? 'Guía Privado Certificado' : 'Certified Private Guide'}
										</div>
										<div class="flex items-center gap-2.5 text-xs font-light py-2 border-b border-white/10">
											<svg class="w-4 h-4 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
											{lang === 'es' ? 'Recojo Directo del Hotel' : 'Hotel Pick-up & Drop-off'}
										</div>
										<div class="flex items-center gap-2.5 text-xs font-light py-2 border-b border-white/10">
											<svg class="w-4 h-4 text-[#dfa126]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
											{lang === 'es' ? 'Itinerario Flexible' : 'Flexible Itinerary'}
										</div>
									</>
								)}
							</div>
							<div class="space-y-4">
								<a 
									href={`https://wa.me/51972438838?text=${encodeURIComponent(`Hola Inkaland Explorers, me gustaría consultar sobre el tour: ${t.title}`)}`}
									target="_blank"
									rel="noopener noreferrer"
									class="block w-full bg-[#dfa126] text-[#0b403a] text-center font-bold py-3 rounded-2xl hover:bg-white hover:text-[#0b403a] transition-all duration-300 transform hover:scale-[1.02] active:scale-95 uppercase tracking-widest text-xs flex items-center justify-center gap-3"
								>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
