---
import Layout from "../../../layouts/Layout.astro";
import SiteFooter from "../../../components/SiteFooter";
import TripInquiryForm from "../../../components/TripInquiryForm";
import { packages } from "../../../data/packages";

const lang = "es";

const groupTours = packages.filter(
	(pkg) => pkg.type && pkg.type.includes("Group Tour"),
);
---

<Layout title="Tours Grupales y Treks en Cusco | Inkaland Explorers" description="Únete a nuestros tours grupales y experimenta el mejor Trekking en Perú. Descubre paquetes asequibles e inolvidables para Treks en Cusco y Machu Picchu." forceScrolled={true}>
	<main class="bg-white">
		<!-- Hero Section -->
		<section
			class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<img
					src="/grupos/bc-group.avif"
					alt="Tours Grupales"
					class="w-full h-full object-cover object-center"
				/>
				<div class="absolute inset-0 bg-black/60"></div>
			</div>
			<div
				class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
			>
				<nav
					class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold"
				>
					<a href="/es" class="hover:text-white transition-colors"
						>Inicio</a
					>
					<span class="mx-3 text-white/30">/</span>
					<span class="text-white/60">Tours</span>
				</nav>
				<h1
					class="font-['Outfit'] text-3xl md:text-5xl font-bold text-white mb-5 leading-tight drop-shadow-2xl"
				>
					Tours Grupales
				</h1>
				<p
					class="text-base md:text-lg text-white/90 font-light max-w-2xl mx-auto leading-relaxed"
				>
					Únete a otros viajeros en estas experiencias únicas por los
					Andes.
				</p>
			</div>
		</section>

		<!-- Tours Grid -->
		<section class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2
						class="text-sm font-bold text-[#dfa126] uppercase tracking-[0.2em] mb-4"
					>
						Experiencias Curadas
					</h2>
					<h3
						class="text-4xl font-bold text-[#0b403a] font-['Outfit']"
					>
						Todos los Tours Grupales
					</h3>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
				>
					{
						groupTours.map((pkg) => (
							<div class="group relative bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100 flex flex-col">
								<a
									href={`/es/tours/${pkg.slug}`}
									class="block relative h-64 overflow-hidden"
								>
									<img
										src={pkg.image}
										alt={pkg.es.title}
										class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
									/>
									<div class="absolute top-4 right-4 px-4 py-1 bg-[#dfa126] rounded-full text-[#0b403a] text-sm font-bold shadow-lg">
										Desde ${pkg.price}
									</div>
								</a>
								<div class="p-8 flex flex-col flex-grow">
									<div class="flex items-center text-[#dfa126] text-xs font-bold uppercase tracking-widest mb-3">
										<span class="mr-2">{pkg.duration}</span>
										<span class="mx-2 text-gray-300">
											|
										</span>
										<span>{pkg.difficulty}</span>
									</div>
									<a
										href={`/es/tours/${pkg.slug}`}
										class="block"
									>
										<h4 class="text-xl font-bold text-[#0b403a] mb-3 font-['Outfit'] group-hover:text-[#dfa126] transition-colors">
											{pkg.es.title}
										</h4>
									</a>
									<p class="text-gray-500 text-sm line-clamp-2 mb-6 leading-relaxed flex-grow">
										{pkg.es.description}
									</p>

									<div class="grid grid-cols-2 gap-4 mt-auto mb-3">
										<a
											href={`/es/tours/${pkg.slug}`}
											class="flex items-center justify-center text-[#0b403a] font-bold text-[11px] uppercase tracking-wider border border-[#0b403a]/20 py-2.5 rounded-xl hover:bg-[#0b403a] hover:text-white transition-all duration-300"
										>
											Ver Detalles
											<svg
												class="w-3 h-3 ml-2"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M17 8l4 4m0 0l-4 4m4-4H3"
												/>
											</svg>
										</a>
										<a
											href={`https://wa.me/51972438838?text=${encodeURIComponent(`Hola Inkaland Explorers, me gustaría consultar sobre el tour: ${pkg.es.title}`)}`}
											target="_blank"
											rel="noopener noreferrer"
											class="flex items-center justify-center bg-[#0b403a] text-white font-bold text-[11px] uppercase tracking-wider py-2.5 rounded-xl hover:bg-[#dfa126] hover:text-[#0b403a] transition-all duration-300 shadow-md shadow-[#0b403a]/20"
										>
											<svg
												class="w-4 h-4 mr-2"
												fill="currentColor"
												viewBox="0 0 24 24"
											>
												<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
											</svg>
											Consultar
										</a>
									</div>
									<a
										href={`https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=inkalandexplorers@gmail.com&item_name=${encodeURIComponent(pkg.es.title)}&amount=${pkg.price}&undefined_quantity=1&currency_code=USD`}
										target="_blank"
										rel="noopener noreferrer"
										class="flex items-center justify-center bg-[#0070ba] text-white font-bold text-[11px] uppercase tracking-wider py-2.5 rounded-xl hover:bg-[#003087] transition-colors shadow-md w-full"
									>
										<svg
											class="w-4 h-4 mr-2"
											viewBox="0 0 24 24"
											fill="currentColor"
										>
											<path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zM9.474 8.76l-.426 2.705h2.19c2.357 0 4.382-.796 4.966-3.805.213-1.096.06-1.922-.44-2.492-.516-.584-1.464-.863-2.827-.863H7.818L6.7 8.76h2.774z" />
										</svg>
										Pagar con PayPal
									</a>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<TripInquiryForm client:visible lang="es" />
	</main>
	<SiteFooter lang="es" />
</Layout>