---
import Layout from "../layouts/Layout.astro";
import TripInquiryForm from "../components/TripInquiryForm";
import SiteFooter from "../components/SiteFooter";
---

<Layout title="About Us | Trekking in Peru & Cusco Experts | Inkaland Explorers" description="Learn about Inkaland Explorers, your trusted local experts for Trekking in Peru, Treks in Cusco, and unforgettable luxury travel experiences." forceScrolled={true}>
	<main class="w-full bg-[#F9F6EE]">
		<!-- Hero Section -->
		<section
			class="relative h-[70vh] min-h-[500px] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<img
					src="/nosotros/about.avif"
					alt="Cusco Landscape"
					class="w-full h-full object-cover"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/20 to-black/80"
				>
				</div>
				<div class="absolute inset-0 bg-[#0b403a]/30"></div>
			</div>

			<div
				class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
			>
				<nav
					class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold"
				>
					<a href="/" class="hover:text-white transition-colors"
						>Home</a
					>
					<span class="mx-3 text-white/30">/</span>
					<span class="text-white/60">About Us</span>
				</nav>
				<h1
					class="font-['Outfit'] text-3xl md:text-5xl font-bold text-white mb-5 leading-tight drop-shadow-2xl"
				>
					About Us
				</h1>
				<p
					class="text-base md:text-lg text-white/90 font-light max-w-2xl mx-auto leading-relaxed"
				>
					A passionate team of local experts dedicated to sharing the
					magic, history, and authentic culture of Peru.
				</p>
			</div>
		</section>

		<!-- Introduction Section -->
		<section class="py-20 px-4">
			<div class="max-w-6xl mx-auto">
				<div
					class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center"
				>
					<div>
						<h2
							class="font-['Outfit'] text-3xl md:text-4xl font-bold text-[#0b403a] mb-6"
						>
							Our Mission & Vision
						</h2>
						<p class="text-gray-600 mb-6 leading-relaxed text-base">
							At <strong>Inkaland Explorers</strong>, we believe
							that travel is more than just visiting a
							destination—it's about connecting with the land, its
							people, and its history. We were founded with a
							clear vision: to offer truly immersive,
							personalized, and sustainable travel experiences in
							the heart of the Andes.
						</p>
						<p class="text-gray-600 leading-relaxed text-base mb-8">
							As a 100% local team, we take pride in showcasing
							the authentic beauty of Peru, far from the standard
							tourist trails. From the mystic ruins of Machu
							Picchu to the vibrant streets of Cusco, every
							journey we craft is designed to leave a positive
							impact on both our guests and our local communities.
						</p>

						<div class="flex items-center gap-4">
							<div
								class="w-12 h-12 rounded-full bg-[#dfa126]/20 flex items-center justify-center text-[#dfa126]"
							>
								<svg
									class="w-6 h-6"
									fill="currentColor"
									viewBox="0 0 24 24"
									><path
										d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"
									></path></svg
								>
							</div>
							<p class="text-[#0b403a] font-bold text-base">
								100% Local & Authentic
							</p>
						</div>
					</div>
					<div class="relative">
						<div
							class="aspect-square rounded-3xl overflow-hidden shadow-2xl relative z-10 border border-black/5"
						>
							<img
								src="/nosotros/mision-vision.avif"
								alt="Local Guide"
								class="w-full h-full object-cover"
							/>
						</div>
						<div
							class="absolute -bottom-8 -left-8 w-64 h-64 bg-[#dfa126] rounded-full mix-blend-multiply filter blur-3xl opacity-30 z-0"
						>
						</div>
						<div
							class="absolute -top-8 -right-8 w-64 h-64 bg-[#0b403a] rounded-full mix-blend-multiply filter blur-3xl opacity-20 z-0"
						>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Why Choose Us -->
		<section class="py-20 px-4 bg-white">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<p
						class="text-[#dfa126] font-bold tracking-widest uppercase text-sm mb-3"
					>
						The Inkaland Difference
					</p>
					<h2
						class="font-['Outfit'] text-2xl md:text-3xl font-bold text-[#0b403a] mb-6"
					>
						Why Travel With Us?
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<!-- Reason 1 -->
					<div
						class="bg-[#F9F6EE] border border-black/5 p-10 rounded-3xl text-center hover:-translate-y-2 transition-transform duration-300"
					>
						<div
							class="w-14 h-14 mx-auto bg-[#dfa126] rounded-xl flex items-center justify-center text-white mb-6 shadow-lg shadow-[#dfa126]/30 rotate-3"
						>
							<svg
								class="w-7 h-7"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
								></path></svg
							>
						</div>
						<h3
							class="font-['Outfit'] text-lg font-bold text-[#0b403a] mb-4"
						>
							Expert Local Guides
						</h3>
						<p class="text-gray-600 leading-relaxed text-sm">
							Our guides are passionate storytellers born and
							raised in the Andes. They offer deep insights into
							our culture, history, and traditions that no
							guidebook can provide.
						</p>
					</div>

					<!-- Reason 2 -->
					<div
						class="bg-[#F9F6EE] border border-black/5 p-10 rounded-3xl text-center hover:-translate-y-2 transition-transform duration-300"
					>
						<div
							class="w-14 h-14 mx-auto bg-[#dfa126] rounded-xl flex items-center justify-center text-white mb-6 shadow-lg shadow-[#dfa126]/30 -rotate-3"
						>
							<svg
								class="w-7 h-7"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
								></path></svg
							>
						</div>
						<h3
							class="font-['Outfit'] text-lg font-bold text-[#0b403a] mb-4"
						>
							Tailored Private Experiences
						</h3>
						<p class="text-gray-600 leading-relaxed text-sm">
							We specialize in private, flexible tours designed
							around your interests, pace, and schedule, ensuring
							an exclusive and unforgettable adventure.
						</p>
					</div>

					<!-- Reason 3 -->
					<div
						class="bg-[#F9F6EE] border border-black/5 p-10 rounded-3xl text-center hover:-translate-y-2 transition-transform duration-300"
					>
						<div
							class="w-14 h-14 mx-auto bg-[#dfa126] rounded-xl flex items-center justify-center text-white mb-6 shadow-lg shadow-[#dfa126]/30 rotate-3"
						>
							<svg
								class="w-7 h-7"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
								><path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.5"
									d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
								></path></svg
							>
						</div>
						<h3
							class="font-['Outfit'] text-lg font-bold text-[#0b403a] mb-4"
						>
							Sustainable Tourism
						</h3>
						<p class="text-gray-600 leading-relaxed text-sm">
							We are committed to ethical travel. We respect
							nature, support local economies, and ensure our
							footprints leave a positive legacy for future
							generations.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Travel Logos -->
		<section class="py-16 px-4 bg-white">
			<div class="max-w-5xl mx-auto flex justify-center items-center">
				<img 
					src="/nosotros/logos-travel.avif" 
					alt="Certifications and Recognitions" 
					class="w-full max-w-3xl h-auto object-contain opacity-80 hover:opacity-100 transition-all duration-300"
					loading="lazy"
					decoding="async"
				/>
			</div>
		</section>

		<!-- Our Location -->
		<section class="py-16 px-4 bg-[#F9F6EE]">
			<div class="max-w-5xl mx-auto flex flex-col items-center">
				<div class="text-center mb-10">
					<p class="text-[#dfa126] font-bold tracking-widest uppercase text-sm mb-3">Our Location</p>
					<h2 class="font-['Outfit'] text-2xl md:text-3xl font-bold text-[#0b403a]">Find Us in Cusco</h2>
				</div>
				<div class="w-full rounded-2xl overflow-hidden shadow-2xl border border-black/5">
					<iframe src="https://maps.google.com/maps?q=Inkaland%20Explorers,%20Cusco,%20Peru&t=h&z=17&ie=UTF8&iwloc=&output=embed" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<TripInquiryForm client:load lang="en" />

		<!-- Footer -->
		<SiteFooter />
	</main>
</Layout>