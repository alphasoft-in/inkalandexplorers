---
import Layout from "../../layouts/Layout.astro";
import SiteFooter from "../../components/SiteFooter";
import TripInquiryForm from "../../components/TripInquiryForm";
import { destinations } from "../../data/destinations";

const lang = "en";
---

<Layout title="Peru Destinations | Machu Picchu, Cusco & Trekking in Peru" description="Explore our breathtaking destinations in Peru. From magical Machu Picchu and the Sacred Valley to the ultimate Trekking in Peru and Treks in Cusco." forceScrolled={true}>
	<main class="bg-white">
		<!-- Hero Section -->
		<section
			class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<img
					src="/machu-picchu/bc-machu-picchu.avif"
					alt="Destinations in Peru"
					class="w-full h-full object-cover object-center"
				/>
				<div class="absolute inset-0 bg-black/60"></div>
			</div>
			<div
				class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
			>
				<nav
					class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold"
				>
					<a href="/" class="hover:text-white transition-colors"
						>Home</a
					>
					<span class="mx-3 text-white/30">/</span>
					<span class="text-white/60">Destinations</span>
				</nav>
				<h1
					class="font-['Outfit'] text-3xl md:text-5xl font-bold text-white mb-5 leading-tight drop-shadow-2xl"
				>
					Destinations
				</h1>
				<p
					class="text-base md:text-lg text-white/90 font-light max-w-2xl mx-auto leading-relaxed"
				>
					Explore the most breathtaking locations in Peru.
				</p>
			</div>
		</section>

		<!-- Destinations Grid -->
		<section class="py-24 bg-white">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="text-center mb-16">
					<h2
						class="text-sm font-bold text-[#dfa126] uppercase tracking-[0.2em] mb-4"
					>
						Discover Peru
					</h2>
					<h3
						class="text-4xl font-bold text-[#0b403a] font-['Outfit']"
					>
						All Destinations
					</h3>
				</div>

				<div
					class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
				>
					{
						destinations.map((dest) => (
							<div class="group relative bg-white rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 border border-gray-100 flex flex-col">
								<a
									href={`/destinations/${dest.slug}`}
									class="block relative h-64 overflow-hidden"
								>
									<img
										src={dest.image}
										alt={dest.en.title}
										class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
									/>
								</a>
								<div class="p-8 flex flex-col flex-grow">
									<a
										href={`/destinations/${dest.slug}`}
										class="block"
									>
										<h4 class="text-xl font-bold text-[#0b403a] mb-3 font-['Outfit'] group-hover:text-[#dfa126] transition-colors">
											{dest.en.title}
										</h4>
									</a>
									<p class="text-gray-500 text-sm line-clamp-3 mb-6 leading-relaxed flex-grow">
										{dest.en.description}
									</p>

									<div class="mt-auto">
										<a
											href={`/destinations/${dest.slug}`}
											class="flex items-center justify-center text-[#0b403a] font-bold text-[11px] uppercase tracking-wider border border-[#0b403a]/20 py-2.5 rounded-xl hover:bg-[#0b403a] hover:text-white transition-all duration-300"
										>
											Explore {dest.en.title}
											<svg
												class="w-3 h-3 ml-2"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M17 8l4 4m0 0l-4 4m4-4H3"
												/>
											</svg>
										</a>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<TripInquiryForm client:visible lang="en" />
	</main>
	<SiteFooter lang="en" />
</Layout>
