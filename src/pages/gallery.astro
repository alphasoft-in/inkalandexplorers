---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter";
import TripInquiryForm from "../components/TripInquiryForm";
import { packages } from "../data/packages";

const uniqueImages = new Map();
packages.forEach(pkg => {
    if (pkg.image && !uniqueImages.has(pkg.image)) {
        uniqueImages.set(pkg.image, {
            src: pkg.image,
            title: pkg.en.title
        });
    }
});

const galleryItems = Array.from(uniqueImages.values());

const getGridClasses = (index: number) => {
    const pos = index % 7;
    if (pos === 0) return "md:col-span-2 h-[250px] md:h-[288px]";
    if (pos === 1) return "md:col-span-2 h-[250px] md:h-[288px]";
    if (pos === 2) return "md:col-span-1 h-[250px] md:h-[288px]";
    if (pos === 3) return "md:col-span-1 h-[250px] md:h-[288px]";
    if (pos === 4) return "md:col-span-1 h-[250px] md:h-[288px]";
    if (pos === 5) return "md:col-span-1 h-[250px] md:h-[288px]";
    if (pos === 6) return "md:col-span-2 h-[250px] md:h-[288px]";
    return "";
};
---

<Layout title="Gallery | Inkaland Explorers" forceScrolled={true}>
	<main class="bg-white">
		<!-- Hero Section -->
		<section
			class="relative h-[70vh] min-h-[500px] flex items-center justify-center overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<img
					src="/galeria/bc-gallery.avif"
					alt="Gallery Background"
					class="w-full h-full object-cover"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/20 to-black/80"
				>
				</div>
				<div class="absolute inset-0 bg-[#0b403a]/30"></div>
			</div>

			<div
				class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
			>
				<nav
					class="flex justify-center mb-6 text-[#dfa126] text-xs uppercase tracking-[0.3em] font-bold"
				>
					<a href="/" class="hover:text-white transition-colors"
						>Home</a
					>
					<span class="mx-3 text-white/30">/</span>
					<span class="text-white/60">Gallery</span>
				</nav>
				<h1
					class="font-['Outfit'] text-3xl md:text-5xl font-bold text-white mb-5 leading-tight drop-shadow-2xl"
				>
					Our Gallery
				</h1>
				<p
					class="text-base md:text-lg text-white/90 font-light max-w-2xl mx-auto leading-relaxed"
				>
					Explore the breathtaking landscapes and unforgettable
					moments of our adventures in Peru.
				</p>
			</div>
		</section>

		<!-- Gallery Grid -->
		<section class="py-24 px-4 bg-white">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-16">
					<h2
						class="text-xs font-bold text-[#dfa126] uppercase tracking-[0.3em] mb-4"
					>
						Visual Journey
					</h2>
					<h3
						class="text-4xl md:text-5xl font-bold text-[#0b403a] font-['Outfit']"
					>
						Memories from the Andes
					</h3>
				</div>

				<!-- Editorial Gallery Layout -->
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-6 auto-rows-min">
					{galleryItems.map((item, index) => (
					<div
						class={`gallery-item ${getGridClasses(index)} rounded-2xl overflow-hidden group relative cursor-pointer`}
						data-src={item.src}
					>
						<img
							src={item.src}
							alt={item.title}
							class="w-full h-full object-cover transition-transform duration-[1.5s] group-hover:scale-105"
						/>
						<div
							class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center p-4 text-center"
						>
							<span
								class="bg-white/90 backdrop-blur-md text-[#0b403a] px-6 py-3 rounded-full font-bold text-xs tracking-widest uppercase transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 line-clamp-2"
							>
								{item.title}
							</span>
						</div>
					</div>
					))}
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<TripInquiryForm client:load lang="en" />

		<!-- Lightbox Overlay -->
		<div
			id="lightbox"
			class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center opacity-0 transition-opacity duration-300"
		>
			<button
				id="lightbox-close"
				class="absolute top-6 right-6 text-white/70 hover:text-white bg-black/20 p-2 rounded-full backdrop-blur-sm transition-colors z-20"
			>
				<svg
					class="w-8 h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>

			<button
				id="lightbox-prev"
				class="absolute left-2 md:left-6 text-white/70 hover:text-white bg-black/20 p-2 md:p-3 rounded-full backdrop-blur-sm transition-colors z-20"
			>
				<svg
					class="w-6 h-6 md:w-8 md:h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M15 19l-7-7 7-7"></path>
				</svg>
			</button>

			<div
				class="flex flex-col items-center justify-center max-w-[85vw] max-h-[90vh]"
			>
				<img
					id="lightbox-img"
					src=""
					alt="Gallery Image"
					class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl relative z-10"
				/>
				<div
					id="lightbox-caption"
					class="w-full text-center text-[#dfa126] font-bold uppercase tracking-[0.2em] text-xs z-20 mt-4 drop-shadow-md px-4"
				>
				</div>
			</div>

			<button
				id="lightbox-next"
				class="absolute right-2 md:right-6 text-white/70 hover:text-white bg-black/20 p-2 md:p-3 rounded-full backdrop-blur-sm transition-colors z-20"
			>
				<svg
					class="w-6 h-6 md:w-8 md:h-8"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 5l7 7-7 7"></path>
				</svg>
			</button>
		</div>

		<!-- Footer -->
		<SiteFooter />
	</main>
</Layout>

<script>
	const lightbox = document.getElementById("lightbox");
	const lightboxImg = document.getElementById(
		"lightbox-img",
	) as HTMLImageElement;
	const closeBtn = document.getElementById("lightbox-close");
	const prevBtn = document.getElementById("lightbox-prev");
	const nextBtn = document.getElementById("lightbox-next");
	const lightboxCaption = document.getElementById("lightbox-caption");
	const galleryItems = document.querySelectorAll(".gallery-item");

	let currentIndex = 0;
	const imagesData = Array.from(galleryItems).map((item) => {
		const img = item.querySelector("img");
		return {
			src: item.getAttribute("data-src"),
			caption: img ? img.getAttribute("alt") : "",
		};
	});

	const showImage = (index: number) => {
		if (index < 0) index = imagesData.length - 1;
		if (index >= imagesData.length) index = 0;
		currentIndex = index;
		const data = imagesData[currentIndex];
		if (data.src && lightboxImg) {
			lightboxImg.src = data.src;
			if (lightboxCaption) {
				lightboxCaption.textContent = data.caption;
			}
		}
	};

	galleryItems.forEach((item, index) => {
		item.addEventListener("click", () => {
			if (lightboxImg && lightbox) {
				showImage(index);
				lightbox.classList.remove("hidden");
				lightbox.classList.add("flex");
				// trigger reflow for animation
				void lightbox.offsetWidth;
				lightbox.classList.remove("opacity-0");
				document.body.style.overflow = "hidden"; // Prevent scrolling
			}
		});
	});

	prevBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		showImage(currentIndex - 1);
	});

	nextBtn?.addEventListener("click", (e) => {
		e.stopPropagation();
		showImage(currentIndex + 1);
	});

	const closeLightbox = () => {
		if (lightbox) {
			lightbox.classList.add("opacity-0");
			setTimeout(() => {
				lightbox.classList.remove("flex");
				lightbox.classList.add("hidden");
				document.body.style.overflow = ""; // Restore scrolling
			}, 300);
		}
	};

	closeBtn?.addEventListener("click", closeLightbox);
	lightbox?.addEventListener("click", (e) => {
		if (e.target === lightbox) closeLightbox();
	});

	// Keyboard navigation
	document.addEventListener("keydown", (e) => {
		if (lightbox && !lightbox.classList.contains("hidden")) {
			if (e.key === "Escape") closeLightbox();
			if (e.key === "ArrowLeft") showImage(currentIndex - 1);
			if (e.key === "ArrowRight") showImage(currentIndex + 1);
		}
	});
</script>
